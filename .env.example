# Copy to .env - never commit real keys.
APP_ENV=dev
CORS_ORIGINS=http://localhost:3000

# Week 2 ingestion (defaults shown; override only if needed):
# EMBEDDING_MODEL=intfloat/multilingual-e5-base
# CHROMA_PATH=.chroma
# DATA_DIR=data

# Week 3: answer generation. Without LLM_API_KEY, /ask runs in retrieval-only mode.
# LLM_PROVIDER=anthropic          # anthropic | openai (openai = any OpenAI-compatible server)
LLM_API_KEY=
# LLM_MODEL=claude-sonnet-5-5     # required for LLM_PROVIDER=openai
# LLM_BASE_URL=                   # e.g. http://localhost:11434/v1 for a local OpenAI-compatible server
# LLM_MAX_TOKENS=800
# LLM_TIMEOUT=60

# Week 3: retrieval
# RAG_STRATEGY=clause             # which Chroma collection to search (fixed | clause | clause_plain)
# TOP_K=5
# MIN_SIMILARITY=0.80             # below this the answer is "I don't know". CALIBRATE: python -m backend.rag.calibrate
